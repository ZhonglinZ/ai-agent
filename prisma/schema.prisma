// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors `StoredWorkflowData` in lib/services/workflowStorage.service.ts
enum WorkflowRunMode {
  once
  periodic
}

enum WorkflowStatus {
  offline
  online
}

model StoredWorkflow {
  id          String          @id
  name        String
  description String?
  runMode     WorkflowRunMode
  status      WorkflowStatus
  /// Canvas nodes (`WorkflowNode[]` serialized as JSON)
  nodes       Json
  /// Canvas edges (`WorkflowEdge[]` serialized as JSON)
  edges       Json
  createdAt   DateTime
  updatedAt   DateTime

  @@map("stored_workflows")
}

/// Mirrors `Agent` in lib/types/agent.ts
enum AgentStatus {
  draft
  published
  offline
}

model Agent {
  id           String      @id
  name         String
  description  String      @default("")
  logo         String      @default("A")
  status       AgentStatus @default(draft)
  modelId      String
  rolePrompt   String      @default("")
  /// `AgentAbilities` serialized as JSON
  abilities    Json
  /// `AgentConversationConfig` serialized as JSON
  conversation Json
  createdAt    DateTime
  updatedAt    DateTime

  @@map("agents")
}
